            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#! /bin/bash\n\nsudo yum update -y\n\n# Install Git\nsudo yum install -y git\n\n# Install Jenkins\n\nsudo wget -O /etc/yum.repos.d/jenkins.repo \\\n    https://pkg.jenkins.io/redhat-stable/jenkins.repo\nsudo rpm --import https://pkg.jenkins.io/redhat-stable/jenkins.io-2023.key\nsudo yum upgrade\nsudo dnf install java-11-amazon-corretto -y\nsudo yum install jenkins -y\n\n\n# Enable jenkins to run on boot\nsudo systemctl enable jenkins\n\n# Start Jenkins\nsudo systemctl start jenkins\n\n# sudo wget -O /etc/yum.repos.d/jenkins.repo \\\n#     https://pkg.jenkins.io/redhat-stable/jenkins.repo\n# sudo rpm --import https://pkg.jenkins.io/redhat-stable/jenkins.io.key\n# sudo yum upgrade -y\n# sudo yum install -y jenkins java-1.8.0-openjdk-devel\nsudo systemctl daemon-reload\n\n\n\n# Install Docker\nsudo yum install docker -y\n# sudo amazon-linux-extras install docker\n\n# Start Docker\nsudo systemctl start docker\n\n# Enable Docker to run on boot\nsudo systemctl enable docker\n\n# Let Jenkins and the current user use docker\nsudo usermod -a -G docker ec2-user\nsudo usermod -a -G docker jenkins\n\n# Create the opt folder in the jenkins home\nsudo mkdir /var/lib/jenkins/opt\nsudo chown jenkins:jenkins  /var/lib/jenkins/opt\n\n# Download and install arachni as jenkins user\nwget https://github.com/Arachni/arachni/releases/download/v1.5.1/arachni-1.5.1-0.5.12-linux-x86_64.tar.gz \ntar -zxf arachni-1.5.1-0.5.12-linux-x86_64.tar.gz \nrm arachni-1.5.1-0.5.12-linux-x86_64.tar.gz \nsudo chown -R jenkins:jenkins arachni-1.5.1-0.5.12/\nsudo mv arachni-1.5.1-0.5.12 /var/lib/jenkins/opt\n\n# Save the instance_id, repositories urls and bucket name to use in the pipeline\nsudo /bin/bash -c \"echo 544775090288.dkr.ecr.us-east-1.amazonaws.com/nodejs-web-app-2026 \u003e /var/lib/jenkins/opt/repository_url\"\nsudo /bin/bash -c \"echo 544775090288.dkr.ecr.us-east-1.amazonaws.com/nodejs-web-app-test-2026 \u003e /var/lib/jenkins/opt/repository_test_url\"\nsudo /bin/bash -c \"echo 544775090288.dkr.ecr.us-east-1.amazonaws.com/nodejs-web-app-staging-2026 \u003e /var/lib/jenkins/opt/repository_staging_url\"\nsudo /bin/bash -c \"echo i-067a79f6027ba5f5b \u003e /var/lib/jenkins/opt/instance_id\"\nsudo /bin/bash -c \"echo ayam-nodejs-web-app-logs-2026 \u003e /var/lib/jenkins/opt/bucket_name\"\n\n# Change ownership and group of these files\nsudo chown -R jenkins:jenkins /var/lib/jenkins/opt/\n\n# Wait for Jenkins to boot up\nsudo sleep 60\n\n\n#####################################################\n#######            SET UP JENKINS             #######\n#####################################################\n\n#---------------------------------------------#\n#------\u003e DEFINE THE GLOBAL VARIABLES \u003c--------#\n#---------------------------------------------#\n\nexport url=\"http://ec2-100-30-83-17.compute-1.amazonaws.com:8080\"\nexport user=\"rapidcode\"\nexport password=\"rapidcode\"\nexport admin_fullname=\"rapidcode\"\nexport admin_email=\"tech@rapidcode.co.in\"\nexport remote=\"git@github.com:ayamkumarrc-png/nodejs-web-app.git\"\nexport jobName=\"CI-CD Pipeline\"\nexport jobID=\"akHXEWnZq1NDH_eyI4Myjw\"\n\n#---------------------------------------------#\n#-----\u003e COPY THE CONFIG FILES FROM S3 \u003c-------#\n#---------------------------------------------#\n\nsudo aws s3 cp s3://ayam-jenkins-config-2026/ ./ --recursive\nsudo chmod +x *.sh\n\n#---------------------------------------------#\n#----------\u003e RUN THE CONFIG FILES  \u003c----------#\n#---------------------------------------------#\n\n./create_admin_user.sh\n./download_install_plugins.sh\nsudo sleep 120\n./confirm_url.sh\n./create_credentials.sh\n\n# Output the credentials id in a credentials_id file\npython -c \"import sys;import json;print(json.loads(raw_input())['credentials'][0]['id'])\" \u003c\u003c\u003c $(./get_credentials_id.sh) \u003e credentials_id\n\n./create_multibranch_pipeline.sh\n\n#---------------------------------------------#\n#---------\u003e DELETE THE CONFIG FILES \u003c---------#\n#---------------------------------------------#\n\nsudo rm *.sh credentials_id\n\nreboot\n",
